# Copy to .env at the repository root and fill in real values. Never commit .env.

# Nebius Token Factory (OpenAI-compatible API)
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://your-nebius-token-factory-base-url/v1

# NVIDIA Nemotron model IDs as listed in Token Factory
MODEL_PLANNER=your-nemotron-ultra-model-id
MODEL_WORKER=your-nemotron-smaller-model-id

# Optional tuning
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Backend
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Repository workspaces (cloned repos). Defaults to ./workspaces at the repo root.
# On a server, use a persistent data disk, e.g. /var/lib/patchpilot/workspaces
# WORKSPACE_ROOT=./workspaces
CLONE_TIMEOUT_SECONDS=120
MAX_REPO_SIZE_MB=200
MAX_SCAN_FILES=5000
MAX_FILE_SIZE_KB=1024

# Coding agent: step and time limits per run; tool mode auto | native | json
AGENT_MAX_STEPS=25
AGENT_TIMEOUT_SECONDS=300
AGENT_TOOL_MODE=auto
# Plan with MODEL_PLANNER before editing (true | false)
AGENT_PLANNING=true

# Phase 2+
GITHUB_TOKEN=your-github-token

# Frontend: set in frontend/.env.local (Next.js only reads env files from its own folder)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
